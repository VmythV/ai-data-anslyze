# 全站访问口令（必填）。为空则任何人都能访问
DA_ACCESS_PASSWORD=change-me
# 加密数据源密码与 API Key 的密钥（必填，部署后不要再改，否则已保存的凭据解不开）
# 生成：python3 -c "import secrets;print(secrets.token_urlsafe(48))"
DA_SECRET_KEY=
# 对外端口
DA_PUBLIC_PORT=8180
# 同时进行的分析数（每个约占用 300MB 内存）
DA_MAX_CONCURRENT_RUNS=4
# 单轮对话 Agent 最多调用模型的次数
DA_AGENT_MAX_TURNS=40
# SQL 结果行数上限与超时（秒）
DA_SQL_MAX_ROWS=50000
DA_SQL_TIMEOUT_SECONDS=30
DA_PYTHON_TIMEOUT_SECONDS=120
# 会话多少天没有新消息就清理它的工作区（查询结果、脚本），对话与报告保留；0 = 不清理
DA_WORKSPACE_RETENTION_DAYS=30
# 联邦查询引擎（Trino）。用 --profile federation 启动 trino 容器后取消下一行的注释
# DA_TRINO_URL=http://trino:8080
# 服务器访问模型接口需要代理时
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=sandbox,trino,mock-mysql,mock-postgres,mock-clickhouse,mock-mongo,localhost,127.0.0.1
